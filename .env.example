# Copy this file to .env and fill in your values. Never commit .env.
PORT=80

# Amazon RDS (MySQL)
DB_HOST=your-db-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_NAME=escuela
DB_USER=admin
DB_PASSWORD=your-password

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=your-session-token
S3_BUCKET=your-bucket-name
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:your-topic
DYNAMO_SESSIONS_TABLE=sesiones-alumnos
